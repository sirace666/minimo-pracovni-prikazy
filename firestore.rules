rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // nastaveni.html od zavedení „levelů" (Basic…Super Admin) ukládá i
    // odvozenou starou `role` (LEVEL2ROLE), ale kdo měl `level` nastavený
    // jinudy (bootstrap/testovací účet, ruční zápis v konzoli) než přes
    // tenhle formulář, může mít `role` nesedící s `level` — proto se admin
    // pozná i přímo podle `level`, ne jen podle `role`.
    function myLevel() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.level;
    }
    // Správci podle e-mailu – platí i kdyby v databázi neměli roli „admin"
    // (drží se shodně s klientem, aby server nezamítal úpravy plnoprávnému správci).
    // admin.test@minimo.local = testovací superadmin účet pro tenhle
    // testovací Firebase projekt (TODO před PR Davidovi: odebrat).
    function isEmailAdmin() {
      return signedIn() && request.auth.token.email in [
        'varhan@minimo.yfai','norkova@minimo.yfai','david.varhan@yanfeng.com','varhandavid19@gmail.com',
        'admin.test@minimo.local'
      ];
    }
    function isAdmin() {
      return isEmailAdmin() || (signedIn() && (myRole() == 'admin' || myLevel() in ['wadmin','superadmin']));
    }
    // Engineering: procesní inženýři a PE koordinátoři. Seznam pozic se drží
    // shodně s klientem (header.js, index.html, engineering.html).
    function myPositions() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('positions', []);
    }
    function isEngineer() {
      return signedIn() && myPositions().hasAny(
        ['IMM PE','SLUSH PE','FOAM PE','ASSY PE','GB/DP PE','PE coordinator']);
    }
    // Kdo smí zakládat a upravovat problem solving, opatření a tasky.
    function canEng()         { return isAdmin() || isEngineer(); }
    // Shopfloor walk: přístup se bere z users.modules.shopfloor (none/read/write),
    // který David nastavuje v Nastavení. Když tam nic není, platí výchozí stav —
    // správci podle e-mailu a PE koordinátoři zapisují, ostatní modul nevidí.
    // Stejná logika je v index.html, header.js, nastaveni.html a shopfloor.html.
    function sfwSet() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data
             .get('modules', {}).get('shopfloor', '');
    }
    function sfwAccess() {
      return !signedIn() ? 'none'
           : sfwSet() in ['none','read','write'] ? sfwSet()
           : (isEmailAdmin() || myPositions().hasAny(['PE coordinator'])) ? 'write'
           : 'none';
    }
    function canSfwRead()  { return signedIn() && sfwAccess() != 'none'; }
    function canSfwWrite() { return signedIn() && sfwAccess() == 'write'; }
    function isSklad()        { return signedIn() && myRole() == 'skladnik'; }
    function isSchvalovatel() { return signedIn() && myRole() == 'schvalovatel'; }
    function canEdit()        { return isAdmin() || isSklad(); }

    // ===== Údržba: práva z Nastavení =====
    // Přístup k modulu = users.modules.udrzba ('write'/'read' = zobrazit, jinak skrytý). Podrobnosti = users.udrzba:
    //   tiles {all, unassigned, parts, mine}: none / read / self / all, assign: none / self / all, ordered, arrived: bool,
    //   edit, del: none / own / all. Správci mají vždy vše. Stejná logika je v udrzba.html (udCan…) a v nastaveni.html (předvolby).
    // „Mé" příkazy = přiřazené mně NEBO mnou založené. Čtení zůstává pro všechny přihlášené (skrytí dlaždic řeší aplikace):
    // dotaz na celou kolekci by při omezení čtení podle dokumentu server celý zamítl.
    function udUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function udShow() { return isAdmin() || udUser().get('modules', {}).get('udrzba', 'none') in ['write', 'read']; }
    function udCfg() { return udUser().get('udrzba', {}); }
    function udTile(t) { return udCfg().get('tiles', {}).get(t, 'none'); }
    function udAs(d) {
      return d.get('assignedTo', []) is list ? d.get('assignedTo', [])
           : (d.get('assignedTo', '') == '' ? [] : [d.get('assignedTo', '')]);
    }
    function udMine(d) { return d.get('author', '') == request.auth.uid || request.auth.uid in udAs(d); }
    function udTileOk(lvl, d) { return lvl == 'all' || (lvl == 'self' && udMine(d)); }
    function udCanWrite(d) {
      return isAdmin() || (udShow() && (
           udTileOk(udTile('all'), d)
        || (udAs(d).size() == 0 && udTileOk(udTile('unassigned'), d))
        || (d.get('nd', null) != null && udTileOk(udTile('parts'), d))
        || (udMine(d) && udTileOk(udTile('mine'), d))));
    }
    function udCanCreate() {
      return isAdmin() || (udShow() && (udTile('all') in ['self', 'all'] || udTile('unassigned') in ['self', 'all']
                                     || udTile('parts') in ['self', 'all'] || udTile('mine') in ['self', 'all']));
    }
    // přiřazení: all = kdokoli, self = smí přidat nebo odebrat jen sebe, none = nikdo
    function udAssignOk(oldAs, newAs) {
      let lvl = udCfg().get('assign', 'none');
      return isAdmin() || lvl == 'all'
        || (lvl == 'self'
            && newAs.toSet().difference(oldAs.toSet()).hasOnly([request.auth.uid].toSet())
            && oldAs.toSet().difference(newAs.toSet()).hasOnly([request.auth.uid].toSet()));
    }
    // číslo WO smí zapsat jen ten, kdo má zvláštní právo „Zapsat WO" (users.udrzba.wo)
    function udWoOk() { return isAdmin() || udCfg().get('wo', false) == true; }
    function udNdOk(v) {
      return isAdmin() || v == null || v == 'potreba'
        || (v == 'objednano' && udCfg().get('ordered', false) == true)
        || (v == 'prisel' && udCfg().get('arrived', false) == true);
    }
    function udUpdateOk() {
      let ch = request.resource.data.diff(resource.data).affectedKeys();
      return !ch.hasAny(['author', 'authorName', 'authorEmail', 'cislo', 'created', 'createdTs'])
        && (!ch.hasAny(['wo']) || udWoOk())
        && (!ch.hasAny(['nazev', 'popis', 'priorita', 'typ', 'linka', 'stroj', 'obor', 'prostojOd'])
            || isAdmin() || udCfg().get('edit', 'none') == 'all'
            || (udCfg().get('edit', 'none') == 'own' && udMine(resource.data)))
        && (!ch.hasAny(['assignedTo', 'assignedToNames']) || udAssignOk(udAs(resource.data), udAs(request.resource.data)))
        && (!ch.hasAny(['nd']) || udNdOk(request.resource.data.get('nd', null)));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // Vlastní jméno a fotku (Můj profil) si smí každý upravit sám; cokoliv
      // dalšího (role, level, positions, perms, modules…) jen admin.
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','firstName','lastName','photoURL','updatedAt']));
      allow delete: if isAdmin();
    }

    match /meta/config {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin()
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seq'])
                        && request.resource.data.seq == resource.data.seq + 1)
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seqUdrzba'])
                        && request.resource.data.seqUdrzba == resource.data.seqUdrzba + 1);
    }

    match /requests/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.author == request.auth.uid
                    && request.resource.data.status in ['nový','ve schvalování'];
      allow update: if canEdit()
                    || (isSchvalovatel()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedBy','approvedAt','status','poznamka','hist']))
                    || (request.auth.uid == resource.data.author
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files','hist']));
      allow delete: if isAdmin();
    }

    // --- Dovolenky ---
    match /people/{id} {
      allow read, write: if signedIn();
    }
    match /absences/{id} {
      allow read, write: if signedIn();
    }
    match /shifts/{id} {
      allow read, write: if signedIn();
    }
    match /rotations/{id} {
      allow read, write: if signedIn();
    }

    // --- Externí opravy ---
    match /opravy/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.author == request.auth.uid;
      allow update: if signedIn() && (canEdit() || resource.data.author == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- Údržba (pilotní modul — v appce zatím vidí jen vybrané e-maily, viz
    // OWNERS v udrzba.html; stejný vzor jako u Opravy/Engineering) ---
    match /udrzba/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.author == request.auth.uid
                    && request.resource.data.status == 'nový'
                    && udCanCreate()
                    && (request.resource.data.get('wo', '') == '' || request.resource.data.get('wo', '') == null || udWoOk())
                    && (isAdmin() || request.resource.data.get('nd', null) == null)
                    && (udAs(request.resource.data).size() == 0
                        || udAssignOk([], udAs(request.resource.data)));
      allow update: if isAdmin() || (udShow() && udCanWrite(resource.data) && udUpdateOk());
      allow delete: if isAdmin()
                    || (udShow() && udCanWrite(resource.data)
                        && (udCfg().get('del', 'none') == 'all'
                            || (udCfg().get('del', 'none') == 'own' && resource.data.get('author', '') == request.auth.uid)));
    }

    // --- Údržba: oblíbené (uložené) sady filtrů — jeden dokument na
    // uživatele, čte/píše jen on sám. Samostatná kolekce, nesahá na nic
    // sdíleného s ostatními moduly.
    match /udrzbaFilters/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // --- Engineering: prostoje ze Symesticu ---
    // Prostoje a denní souhrny čte každý přihlášený. Report nahraje kdokoli
    // z engineeringu (procesní inženýr, koordinátor, správce) — import je
    // idempotentní, opakované nahrání téhož reportu nic nezdvojí.
    match /downtimes/{id} {
      allow read:  if signedIn();
      allow write: if canEng();
    }
    match /dt_days/{datum} {
      allow read:  if signedIn();
      allow write: if canEng();
    }
    // --- Engineering: scrap (zmetky v eurech proti tržbám) ---
    match /scrap/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }
    match /sc_months/{mesic} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // --- Engineering: řízení výkonu (problem solving a opatření) ---
    // Nastavení standardu (práh výkonu, manažer, stroje) mění jen správce.
    // Inženýr smí zvýšit jen čítače čísel — bez toho by nezaložil nový záznam.
    match /meta/engcfg {
      allow read:   if signedIn();
      // Dokument může poprvé vzniknout i pod inženýrem — jinak by nezaložil
      // vůbec nic, dokud správce neuloží nastavení standardu.
      allow create: if canEng();
      allow update: if isAdmin()
                    || (canEng()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['seqPs','seqAct','seqTask']));
      allow delete: if isAdmin();
    }
    // Problem solving a opatření zakládají a upravují inženýři a koordinátoři,
    // mazat je smí jen správce.
    match /problems/{id} {
      allow read:   if signedIn();
      allow create, update: if canEng();
      allow delete: if isAdmin();
    }
    match /actions/{id} {
      allow read:   if signedIn();
      allow create, update: if canEng();
      allow delete: if isAdmin();
    }

    // --- Engineering: akční plán managementu ---
    // Tasky vidí každý přihlášený, zakládají a upravují je inženýři a správce.
    match /tasks/{id} {
      allow read:   if signedIn();
      allow create, update: if canEng();
      allow delete: if isAdmin();
    }

    // --- Shopfloor walk: nálezy z obchůzky s plant manažerem ---
    // Nálezy vidí jen ti, kdo do modulu smí (ne každý přihlášený jako u prostojů) —
    // je to zápisník z obchůzky vedení, ne provozní data.
    match /sfw/{id} {
      allow read:   if canSfwRead();
      allow create, update: if canSfwWrite();
      allow delete: if isAdmin();
    }
    // Čítač čísel nálezů. Smí ho zvýšit každý, kdo smí zapisovat — jinak by
    // nový nález nezaložil. Nic jiného se v dokumentu měnit nedá.
    match /meta/sfwcfg {
      allow read:   if canSfwRead();
      allow create: if canSfwWrite();
      allow update: if isAdmin()
                    || (canSfwWrite()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seq']));
      allow delete: if isAdmin();
    }

    // Záznam v historii importů jde jen založit, ne měnit ani mazat.
    match /dt_imports/{id} {
      allow read:   if signedIn();
      allow create: if canEng();
      allow update, delete: if false;
    }

  }
}
