rules_version = '2';

// Pravidla úložiště souborů (Firebase Storage) pro minimo · YFAI.
// Publikuje se ručně v konzoli Firebase: Storage → Rules → Publish.
// Pozor: tohle NENÍ totéž co pravidla Firestore, ta se publikují jinde.
service firebase.storage {
  match /b/{bucket}/o {

    // Nabídky a přílohy k nákupním požadavkům
    match /nabidky/{requestId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Přílohy k taskům akčního plánu (Engineering)
    match /tasky/{taskId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Přílohy a fotky k problem solvingu (Engineering)
    match /ps/{psId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Můj profil: profilová fotka (jen svoje vlastní) — naše pravidlo, MUSÍ být
    // před posledním pravidlem „nic jiného", jinak by ho zakázalo.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 3 * 1024 * 1024;   // max 3 MB
    }

    // Fotky z obchůzky (Shopfloor walk)
    match /sfw/{findingId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Nic jiného do úložiště nepatří.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
