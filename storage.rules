rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // --- Nákupní požadavky ---
    match /nabidky/{requestId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024;   // max 5 MB na soubor
    }

    // --- Engineering: akční plán ---
    match /tasky/{taskId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024;   // max 5 MB na soubor
    }

    // --- Můj profil: profilová fotka (jen svoje vlastní) ---
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 3 * 1024 * 1024;   // max 3 MB
    }
  }
}
